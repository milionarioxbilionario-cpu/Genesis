# ============================================================================
# GENESIS BACKEND — MODELO DE CONFIGURACAO
#
# Copia este ficheiro para `.env` (na mesma pasta) e preenche os valores.
# O `.env` NUNCA vai para o git (ver .gitignore). Este ficheiro, sim.
#
#   cp .env.example .env      # (Linux/macOS)
#   copy .env.example .env    # (Windows)
#
# REGRA DE OURO: nenhum segredo real entra em ficheiros versionados. Se uma
# chave aparecer em texto claro num ficheiro que vai para o git, considera-a
# comprometida e ROTACIONA-A.
# ============================================================================

# ---------- Base de dados (PostgreSQL / Supabase) ----------
# Runtime: pooler em modo SESSAO (porta 5432). O modo transacao (6543) parte
# transacoes interativas do Prisma e o contexto RLS (app.tenant_id).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"
# Usado por migracoes e introspeccao.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------- Escolha do motor (ver src/utils/dbEngine.js) ----------
# Em PRODUCAO deixa a "false": nunca servir dados de uma base errada.
# Em desenvolvimento, "true" permite cair para SQLite local se o Postgres nao
# responder (os dados ficam so nesta maquina e o RLS NAO se aplica).
DB_ALLOW_SQLITE_FALLBACK=false
DB_PROBE_TIMEOUT_MS=6000

# ---------- Supabase ----------
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# ATENCAO: a SECRET key da controlo total sobre a base de dados. Nunca a
# exponhas no frontend nem em ficheiros versionados.
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL="https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json"

# ---------- Twilio (WhatsApp) ----------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+258XXXXXXXX"

# ---------- App ----------
PORT=4000
NODE_ENV=development

# ---------- Autenticacao ----------
# OBRIGATORIO. Gera valores ALEATORIOS e longos (>= 32 caracteres).
# Exemplo (Windows PowerShell):
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(48)).ToLower()
# Em producao o servidor RECUSA arrancar se JWT_SECRET for ausente/fraco.
JWT_SECRET="ALTERA-ISTO-para-um-valor-aleatorio-de-48-bytes"
JWT_EXPIRY="12h"
REFRESH_TOKEN_SECRET="ALTERA-ISTO-tambem-para-um-valor-aleatorio-diferente"
REFRESH_TOKEN_EXPIRY="30d"

# ---------- Seed de demonstracao (OPT-IN) ----------
# NUNCA activar em producao. So corre com SEED_DEMO_DATA=true e exige as
# passwords abaixo.
SEED_DEMO_DATA=false
DEMO_OWNER_PASSWORD=""
DEMO_CASHIER_PASSWORD=""
DEMO_ADMIN_PASSWORD=""
DEMO_OWNER_EMAIL="owner@genesis.local"

# ---------- Google (Google Identity Services) ----------
# Tem de ter formato XXXX.apps.googleusercontent.com (uma API Key AIza... NAO serve).
GOOGLE_CLIENT_ID=""

# ---------- E-mail (SMTP Gmail) ----------
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""
# Em PRODUCAO tem de ser "false": devolve o codigo de reset no ecra.
DEV_SHOW_RESET_CODE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ---------- Genesis 2.0: rede e origens ----------
# Origens do browser autorizadas (CORS). Em producao: a app e o painel admin.
CORS_ORIGINS="http://localhost:5173,http://localhost:5175"
# Origem do painel admin (o /api/admin/* so aceita pedidos daqui).
ADMIN_ORIGINS="http://localhost:5175"
# Endereco da app da loja (o modo suporte do admin abre aqui).
APP_URL="http://localhost:5173"
# So atras de um proxy (nginx): 1. Sem proxy deixa vazio — confiar no header
# X-Forwarded-For deixaria qualquer cliente falsificar o IP.
TRUST_PROXY=
# Transaccoes interactivas (ms). O Supabase em eu-central-1 responde a ~1,2 s
# por query a partir de Maputo; aloja o backend na mesma regiao da BD.
DB_TX_TIMEOUT_MS=45000
DB_TX_MAX_WAIT_MS=15000

# ---------- Genesis 2.0: RLS (isolamento entre lojas no Postgres) ----------
# Papel da aplicacao SEM bypassrls (criado com prisma/rls_v2.sql). Os pedidos
# de cada loja usam esta ligacao; DATABASE_URL (postgres) fica para o sistema.
# Em producao o servidor recusa arrancar sem ela.
APP_DATABASE_URL="postgresql://genesis_app.SEU-PROJETO:SENHA@HOST:5432/postgres?pgbouncer=true"
# So para diagnostico local: false desliga o RLS (nunca em producao).
DB_RLS_ENFORCE=true
# Cache do estado da loja (suspensa/trial), em ms.
TENANT_STATUS_CACHE_MS=30000
