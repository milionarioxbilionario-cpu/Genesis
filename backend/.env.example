# Example .env for Genesis backend - DO NOT COMMIT SECRETS TO REPO
# Copy this file to .env locally and fill real values. Add .env to .gitignore.

# Database: use a Postgres connection in production (Supabase)
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>?schema=public"
# For local sqlite dev use: "file:./dev.db"
DIRECT_URL="file:./dev.db"

# JWT
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRY="24h"

# Supabase (only for referencing project; do not store service_role in frontend)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="<anon-key-placeholder>"
# KEEP service role secret out of this file and only set on admin servers
SUPABASE_SERVICE_ROLE="<service-role-key-keep-secret>"

# Twilio for WhatsApp (fill if you integrate)
TWILIO_SID="<twilio-sid>"
TWILIO_TOKEN="<twilio-token>"
TWILIO_WHATSAPP_FROM="whatsapp:+258xxxxxxxx"

# App
PORT=4000

# Seed de demonstração (OPT-IN — nunca activar em produção)
# Só corre se SEED_DEMO_DATA=true. Cria as contas de demonstração
# owner@genesis.local, cashier@genesis.local e admin@genesis.co.mz (esta última
# com papel super_admin) — por isso as passwords têm de vir do .env (nunca do
# código) e ser alteradas antes de qualquer ambiente público.
SEED_DEMO_DATA="false"
DEMO_OWNER_PASSWORD="<define-a-locally>"
DEMO_CASHIER_PASSWORD="<define-a-locally>"
DEMO_ADMIN_PASSWORD="<define-a-locally>"
# Usado por test.sh para o smoke test de login
DEMO_OWNER_EMAIL="owner@genesis.local"

# Notes:
# - After creating .env from .env.example, DO NOT commit .env. Use CI secrets for deploy.
# - Rotate any leaked keys immediately (Supabase, Twilio, JWT secret).
