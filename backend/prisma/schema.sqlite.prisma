generator client {
  provider = "prisma-client-js"
}

// ============================================================================
//  SCHEMA PARA DESENVOLVIMENTO LOCAL EM SQLITE (24-09-2026)
//
//  Porquê este ficheiro separado:
//  o Prisma valida a URL no construtor do cliente e so aceita o protocolo do
//  provider declarado. Um cliente gerado com provider "postgresql" RECUSA um
//  URL `file:` (verificado experimentalmente). Como o Prisma exige um schema
//  estatico por provider, o caminho SQLite precisa do seu proprio schema.
//
//  COMO SE USA
//  - O ficheiro activo e escolhido por src/utils/dbEngine.js + um script npm.
//  - `prisma/schema.prisma`        -> PostgreSQL (Supabase). Alvo de producao.
//  - `prisma/schema.sqlite.prisma` -> SQLite, so para trabalhar offline.
//
//  REGRA DE OURO: este ficheiro tem de ficar IDENTICO ao schema.prisma de
//  PostgreSQL, excepto no bloco `datasource`. Se o mudares a mao, copia-o
//  novamente (ver package.json -> prisma:schema:sqlite).
//
//  ATENCAO: o SQLite NAO tem Row Level Security. O isolamento entre empresas
//  e feito na camada de aplicacao (applyTenantRls e os filtros por tenant_id).
//  Para isolamento garantido pela base de dados, usa PostgreSQL.
// ============================================================================

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                @id @default(uuid())
  name                  String
  owner_name            String
  business_type         String
  location              String
  phone                 String
  email                 String?
  nuit                  String?
  id_document           String?
  status                String                @default("pending")
  trial_ends_at         DateTime?
  onboarding_completed  Boolean               @default(false)
  subscription_price    Int                   @default(300000)
  created_at            DateTime              @default(now())
  cancel_pin_hash       String?
  audit_logs            AuditLog[]
  debts                 Debt[]
  demand_captures       DemandCapture[]
  employees             Employee[]
  fixed_costs           FixedCost[]
  products              Product[]
  product_price_history ProductPriceHistory[]
  sales                 Sale[]
  sale_goals            SaleGoal[]
  shift_closings        ShiftClosing[]
  shrinkage_records     ShrinkageRecord[]
  stock_entries         StockEntry[]
  suppliers             Supplier[]
  users                 User[]                @relation("TenantUsers")
}

model User {
  id                         String                @id @default(uuid())
  tenant_id                  String?
  role                       String
  name                       String
  email                      String                @unique
  password_hash              String
  phone                      String?
  is_active                  Boolean               @default(true)
  created_at                 DateTime              @default(now())
  audit_logs                 AuditLog[]
  debts_created              Debt[]                @relation("DebtCreator")
  debt_payments              DebtPayment[]
  demand_captures_recorded   DemandCapture[]       @relation("DemandCapturedBy")
  product_price_changes      ProductPriceHistory[] @relation("PriceChangedBy")
  sales                      Sale[]                @relation("CashierSales")
  shift_closings_user        ShiftClosing[]        @relation("ShiftClosedBy")
  shrinkage_records_recorded ShrinkageRecord[]     @relation("ShrinkageRecordedBy")
  stock_entries              StockEntry[]
  tenant                     Tenant?               @relation("TenantUsers", fields: [tenant_id], references: [id])
}

model Product {
  id                    String                @id @default(uuid())
  tenant_id             String
  name                  String
  category              String
  barcode               String?
  image_url             String?
  cost_price            Int                   @default(0)
  sell_price            Int                   @default(0)
  stock_qty             Int                   @default(0)
  min_stock             Int                   @default(5)
  has_expiry            Boolean               @default(false)
  expiry_date           DateTime?
  is_active             Boolean               @default(true)
  created_at            DateTime              @default(now())
  demand_captures       DemandCapture[]
  tenant                Tenant                @relation(fields: [tenant_id], references: [id])
  product_price_history ProductPriceHistory[]
  sale_items            SaleItem[]
  shrinkage_records     ShrinkageRecord[]
  stock_entries         StockEntry[]
}

model Sale {
  id              String     @id @default(uuid())
  tenant_id       String
  cashier_user_id String
  total_amount    Int
  total_cost      Int
  payment_method  String
  amount_received Int
  change_given    Int
  status          String
  cancelled_by    String?
  cancel_reason   String?
  created_at      DateTime   @default(now())
  discount_amount Int        @default(0)
  daily_number    Int?
  cashier         User       @relation("CashierSales", fields: [cashier_user_id], references: [id])
  tenant          Tenant     @relation(fields: [tenant_id], references: [id])
  items           SaleItem[]

  @@index([tenant_id, created_at], map: "Sale_tenant_created_idx")
}

model SaleItem {
  id              String  @id @default(uuid())
  sale_id         String
  product_id      String
  product_name    String
  quantity        Int
  unit_sell_price Int
  unit_cost_price Int
  product         Product @relation(fields: [product_id], references: [id])
  sale            Sale    @relation(fields: [sale_id], references: [id])
}

model StockEntry {
  id          String   @id @default(uuid())
  tenant_id   String
  product_id  String
  quantity    Int
  unit_cost   Int
  supplier_id String?
  recorded_by String
  created_at  DateTime @default(now())
  recordedBy  User     @relation(fields: [recorded_by], references: [id])
  product     Product  @relation(fields: [product_id], references: [id])
  tenant      Tenant   @relation(fields: [tenant_id], references: [id])
}

model Employee {
  id             String    @id @default(uuid())
  tenant_id      String
  name           String
  role           String
  monthly_salary Int
  phone          String?
  start_date     DateTime?
  is_active      Boolean   @default(true)
  tenant         Tenant    @relation(fields: [tenant_id], references: [id])
}

model Supplier {
  id                      String  @id @default(uuid())
  tenant_id               String
  name                    String
  phone                   String
  delivery_cost_per_visit Int
  is_active               Boolean @default(true)
  tenant                  Tenant  @relation(fields: [tenant_id], references: [id])
}

model FixedCost {
  id          String @id @default(uuid())
  tenant_id   String
  description String
  amount      Int
  type        String
  tenant      Tenant @relation(fields: [tenant_id], references: [id])
}

model Debt {
  id           String        @id @default(uuid())
  tenant_id    String
  debtor_name  String
  debtor_phone String
  total_amount Int
  amount_paid  Int           @default(0)
  due_date     DateTime
  status       String
  created_by   String
  created_at   DateTime      @default(now())
  createdBy    User          @relation("DebtCreator", fields: [created_by], references: [id])
  tenant       Tenant        @relation(fields: [tenant_id], references: [id])
  payments     DebtPayment[]
}

model DebtPayment {
  id          String   @id @default(uuid())
  debt_id     String
  amount      Int
  paid_at     DateTime @default(now())
  recorded_by String
  recordedBy  User     @relation(fields: [recorded_by], references: [id])
  debt        Debt     @relation(fields: [debt_id], references: [id])
}

model DemandCapture {
  id           String   @id @default(uuid())
  tenant_id    String
  product_id   String
  recorded_by  String
  requested_at DateTime @default(now())
  recordedBy   User     @relation("DemandCapturedBy", fields: [recorded_by], references: [id])
  product      Product  @relation(fields: [product_id], references: [id])
  tenant       Tenant   @relation(fields: [tenant_id], references: [id])
}

model ShrinkageRecord {
  id          String   @id @default(uuid())
  tenant_id   String
  product_id  String
  quantity    Int
  reason      String
  recorded_by String
  recorded_at DateTime @default(now())
  recordedBy  User     @relation("ShrinkageRecordedBy", fields: [recorded_by], references: [id])
  product     Product  @relation(fields: [product_id], references: [id])
  tenant      Tenant   @relation(fields: [tenant_id], references: [id])
}

model ShiftClosing {
  id              String   @id @default(uuid())
  tenant_id       String
  cashier_user_id String
  counted_amount  Int
  expected_amount Int
  difference      Int
  closed_at       DateTime @default(now())
  cashier         User     @relation("ShiftClosedBy", fields: [cashier_user_id], references: [id])
  tenant          Tenant   @relation(fields: [tenant_id], references: [id])
}

model SaleGoal {
  id            String   @id @default(uuid())
  tenant_id     String
  month         Int
  year          Int
  target_amount Int
  created_at    DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenant_id], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenant_id   String?
  user_id     String
  action      String
  entity_type String
  entity_id   String?
  old_value   String?
  new_value   String?
  ip_address  String
  created_at  DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenant_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])
}

model MasterCatalog {
  id             String @id @default(uuid())
  business_type  String
  product_name   String
  category       String
  suggested_cost Int
  suggested_sell Int
}

model ProductPriceHistory {
  id         String   @id @default(uuid())
  tenant_id  String
  product_id String
  old_cost   Int
  new_cost   Int
  changed_at DateTime @default(now())
  changed_by String
  changedBy  User     @relation("PriceChangedBy", fields: [changed_by], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])
  tenant     Tenant   @relation(fields: [tenant_id], references: [id])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model device_keys {
  id            String?   @id
  device_name   String
  key_hash      String
  owner_user_id String
  tenant_id     String
  created_at    DateTime? @default(now())
  last_used_at  DateTime?
  revoked_at    DateTime?
  metadata      String?

  @@ignore
}
