generator client {
  provider = "prisma-client-js"
}

// ============================================================================
//  SCHEMA PARA DESENVOLVIMENTO LOCAL EM SQLITE (24-09-2026)
//
//  Porquê este ficheiro separado:
//  o Prisma valida a URL no construtor do cliente e so aceita o protocolo do
//  provider declarado. Um cliente gerado com provider "postgresql" RECUSA um
//  URL `file:` (verificado experimentalmente). Como o Prisma exige um schema
//  estatico por provider, o caminho SQLite precisa do seu proprio schema.
//
//  COMO SE USA
//  - O ficheiro activo e escolhido por src/utils/dbEngine.js + um script npm.
//  - `prisma/schema.prisma`        -> PostgreSQL (Supabase). Alvo de producao.
//  - `prisma/schema.sqlite.prisma` -> SQLite, so para trabalhar offline.
//
//  REGRA DE OURO: este ficheiro tem de ficar IDENTICO ao schema.prisma de
//  PostgreSQL, excepto no bloco `datasource`. Se o mudares a mao, copia-o
//  novamente (ver package.json -> prisma:schema:sqlite).
//
//  ATENCAO: o SQLite NAO tem Row Level Security. O isolamento entre empresas
//  e feito na camada de aplicacao (applyTenantRls e os filtros por tenant_id).
//  Para isolamento garantido pela base de dados, usa PostgreSQL.
// ============================================================================

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                @id @default(uuid())
  name                  String
  owner_name            String
  business_type         String
  location              String
  phone                 String
  email                 String?
  nuit                  String?
  id_document           String?
  status                String                @default("pending")
  trial_ends_at         DateTime?
  onboarding_completed  Boolean               @default(false)
  subscription_price    Int                   @default(300000)
  created_at            DateTime              @default(now())
  cancel_pin_hash       String?
  // Genesis 2.0: politica de descontos e horario persistidos (antes num Map em memoria).
  discount_free_pct     Int                   @default(10)
  opening_time          String?
  closing_time          String?
  // Genesis 2.1: avisar X dias antes de um lote expirar.
  expiry_alert_days     Int                   @default(7)
  month_close_day       Int                   @default(1)
  pos_terminals         PosTerminal[]
  audit_logs            AuditLog[]
  debts                 Debt[]
  demand_captures       DemandCapture[]
  employees             Employee[]
  expenses              Expense[]
  catalog_suggestions   CatalogSuggestion[]
  shopping_lists        ShoppingList[]
  shopping_list_items   ShoppingListItem[]
  fixed_costs           FixedCost[]
  products              Product[]
  product_price_history ProductPriceHistory[]
  sales                 Sale[]
  sale_goals            SaleGoal[]
  shift_closings        ShiftClosing[]
  shrinkage_records     ShrinkageRecord[]
  stock_entries         StockEntry[]
  stock_lots            StockLot[]
  suppliers             Supplier[]
  users                 User[]                @relation("TenantUsers")
}

model User {
  id                         String                @id @default(uuid())
  tenant_id                  String?
  role                       String
  name                       String
  email                      String                @unique
  password_hash              String
  // PIN pessoal do caixista no terminal da loja (bcrypt). Null = sem acesso ao POS.
  pin_hash                   String?
  phone                      String?
  is_active                  Boolean               @default(true)
  created_at                 DateTime              @default(now())
  audit_logs                 AuditLog[]
  debts_created              Debt[]                @relation("DebtCreator")
  debt_payments              DebtPayment[]
  demand_captures_recorded   DemandCapture[]       @relation("DemandCapturedBy")
  product_price_changes      ProductPriceHistory[] @relation("PriceChangedBy")
  sales                      Sale[]                @relation("CashierSales")
  shift_closings_user        ShiftClosing[]        @relation("ShiftClosedBy")
  shrinkage_records_recorded ShrinkageRecord[]     @relation("ShrinkageRecordedBy")
  stock_entries              StockEntry[]
  tenant                     Tenant?               @relation("TenantUsers", fields: [tenant_id], references: [id])
}

model Product {
  id                    String                @id @default(uuid())
  tenant_id             String
  name                  String
  category              String
  barcode               String?
  image_url             String?
  /// Icone escolhido pelo dono (chave de utils/productIcons.js); null = icone da categoria.
  icon                  String?
  cost_price            Int                   @default(0)
  sell_price            Int                   @default(0)
  stock_qty             Int                   @default(0)
  min_stock             Int                   @default(5)
  has_expiry            Boolean               @default(false)
  expiry_date           DateTime?
  is_active             Boolean               @default(true)
  created_at            DateTime              @default(now())
  demand_captures       DemandCapture[]
  tenant                Tenant                @relation(fields: [tenant_id], references: [id])
  product_price_history ProductPriceHistory[]
  sale_items            SaleItem[]
  shrinkage_records     ShrinkageRecord[]
  stock_entries         StockEntry[]
  stock_lots            StockLot[]
}

model Sale {
  id              String     @id @default(uuid())
  tenant_id       String
  cashier_user_id String
  total_amount    Int
  total_cost      Int
  payment_method  String
  amount_received Int
  change_given    Int
  status          String
  cancelled_by    String?
  cancel_reason   String?
  created_at      DateTime   @default(now())
  discount_amount Int        @default(0)
  daily_number    Int?
  cashier         User       @relation("CashierSales", fields: [cashier_user_id], references: [id])
  tenant          Tenant     @relation(fields: [tenant_id], references: [id])
  items           SaleItem[]

  @@index([tenant_id, created_at], map: "Sale_tenant_created_idx")
}

model SaleItem {
  id              String  @id @default(uuid())
  sale_id         String
  product_id      String
  product_name    String
  quantity        Int
  unit_sell_price Int
  unit_cost_price Int
  product         Product @relation(fields: [product_id], references: [id])
  sale            Sale    @relation(fields: [sale_id], references: [id])
}

model StockEntry {
  id          String   @id @default(uuid())
  tenant_id   String
  product_id  String
  quantity    Int
  unit_cost   Int
  supplier_id String?
  recorded_by String
  created_at  DateTime @default(now())
  recordedBy  User     @relation(fields: [recorded_by], references: [id])
  product     Product  @relation(fields: [product_id], references: [id])
  tenant      Tenant   @relation(fields: [tenant_id], references: [id])
}

model Employee {
  id             String    @id @default(uuid())
  tenant_id      String
  name           String
  role           String
  monthly_salary Int
  phone          String?
  start_date     DateTime?
  is_active      Boolean   @default(true)
  tenant         Tenant    @relation(fields: [tenant_id], references: [id])
}

model Supplier {
  id                      String  @id @default(uuid())
  tenant_id               String
  name                    String
  phone                   String
  delivery_cost_per_visit Int
  is_active               Boolean @default(true)
  tenant                  Tenant  @relation(fields: [tenant_id], references: [id])
}

model FixedCost {
  id          String @id @default(uuid())
  tenant_id   String
  description String
  amount      Int
  type        String
  tenant      Tenant @relation(fields: [tenant_id], references: [id])
}

model Debt {
  id           String        @id @default(uuid())
  tenant_id    String
  debtor_name  String
  debtor_phone String
  total_amount Int
  amount_paid  Int           @default(0)
  due_date     DateTime
  status       String
  created_by   String
  created_at   DateTime      @default(now())
  createdBy    User          @relation("DebtCreator", fields: [created_by], references: [id])
  tenant       Tenant        @relation(fields: [tenant_id], references: [id])
  payments     DebtPayment[]
}

model DebtPayment {
  id          String   @id @default(uuid())
  debt_id     String
  amount      Int
  paid_at     DateTime @default(now())
  recorded_by String
  recordedBy  User     @relation(fields: [recorded_by], references: [id])
  debt        Debt     @relation(fields: [debt_id], references: [id])
}

model DemandCapture {
  id           String   @id @default(uuid())
  tenant_id    String
  product_id   String
  recorded_by  String
  requested_at DateTime @default(now())
  recordedBy   User     @relation("DemandCapturedBy", fields: [recorded_by], references: [id])
  product      Product  @relation(fields: [product_id], references: [id])
  tenant       Tenant   @relation(fields: [tenant_id], references: [id])
}

model ShrinkageRecord {
  id          String   @id @default(uuid())
  tenant_id   String
  product_id  String
  quantity    Int
  reason      String
  recorded_by String
  recorded_at DateTime @default(now())
  // Genesis 2.1: lote de onde saiu e custo unitario (valor da perda nos relatorios).
  lot_id      String?
  unit_cost   Int?
  recordedBy  User     @relation("ShrinkageRecordedBy", fields: [recorded_by], references: [id])
  product     Product  @relation(fields: [product_id], references: [id])
  tenant      Tenant   @relation(fields: [tenant_id], references: [id])
}

// Genesis 2.1 — stock por lote (validades). Product.stock_qty continua a ser a
// fonte de verdade da quantidade; os lotes dizem de que data e esse stock.
// Saidas descontam por FEFO (utils/fefo.js). quantity_remaining 0 = lote fechado.
model StockLot {
  id                 String    @id @default(uuid())
  tenant_id          String
  product_id         String
  stock_entry_id     String?
  quantity_remaining Int
  expiry_date        DateTime?
  unit_cost          Int       @default(0)
  created_at         DateTime  @default(now())
  product            Product   @relation(fields: [product_id], references: [id])
  tenant             Tenant    @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, product_id, expiry_date])
}

model ShiftClosing {
  id              String   @id @default(uuid())
  tenant_id       String
  cashier_user_id String
  counted_amount  Int
  expected_amount Int
  difference      Int
  closed_at       DateTime @default(now())
  /// Dia de Maputo (AAAA-MM-DD) em que o turno comecou — um fecho por dia (utils/shiftDay.js).
  shift_day       String?
  cashier         User     @relation("ShiftClosedBy", fields: [cashier_user_id], references: [id])
  tenant          Tenant   @relation(fields: [tenant_id], references: [id])
}

model SaleGoal {
  id            String   @id @default(uuid())
  tenant_id     String
  month         Int
  year          Int
  target_amount Int
  created_at    DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenant_id], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenant_id   String?
  user_id     String
  action      String
  entity_type String
  entity_id   String?
  old_value   String?
  new_value   String?
  ip_address  String
  created_at  DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenant_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])
}

model MasterCatalog {
  id             String @id @default(uuid())
  business_type  String
  product_name   String
  category       String
  suggested_cost Int
  suggested_sell Int
  barcode        String?
  image_url      String?
  icon           String?
}

model ProductPriceHistory {
  id         String   @id @default(uuid())
  tenant_id  String
  product_id String
  old_cost   Int
  new_cost   Int
  changed_at DateTime @default(now())
  changed_by String
  changedBy  User     @relation("PriceChangedBy", fields: [changed_by], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])
  tenant     Tenant   @relation(fields: [tenant_id], references: [id])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model device_keys {
  id            String?   @id
  device_name   String
  key_hash      String
  owner_user_id String
  tenant_id     String
  created_at    DateTime? @default(now())
  last_used_at  DateTime?
  revoked_at    DateTime?
  metadata      String?

  @@ignore
}

/// Terminal POS emparelhado a uma loja (Genesis 2.0). Substitui device_keys
/// (que nao tem chave primaria). O segredo vive num cookie httpOnly do browser
/// do balcao; aqui so o hash.
model PosTerminal {
  id           String    @id @default(uuid())
  tenant_id    String
  name         String
  secret_hash  String
  created_by   String
  created_at   DateTime  @default(now())
  last_seen_at DateTime?
  revoked_at   DateTime?
  tenant       Tenant    @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
}

// Despesas avulsas (Genesis 2.1, Fase 5): limpeza, transporte, luz... do dia a
// dia, alem dos custos fixos mensais. Entram no lucro liquido do mes.
model Expense {
  id          String   @id @default(uuid())
  tenant_id   String
  date        DateTime
  category    String
  description String
  amount      Int
  created_by  String
  created_at  DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, date])
}

// Lista de compras (Genesis 2.1, Fase 5): gerada da recomendacao de restock ou
// feita a mao; enviada ao fornecedor por WhatsApp (wa.me). Estado: draft |
// sent | received. O item guarda o nome do produto no momento da lista.
model ShoppingList {
  id          String             @id @default(uuid())
  tenant_id   String
  name        String
  status      String             @default("draft")
  supplier_id String?
  created_by  String
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenant_id], references: [id])
  items       ShoppingListItem[]

  @@index([tenant_id, created_at])
}

model ShoppingListItem {
  id           String       @id @default(uuid())
  tenant_id    String
  list_id      String
  product_id   String
  product_name String
  quantity     Int
  unit_cost    Int
  list         ShoppingList @relation(fields: [list_id], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, list_id])
}


// Produto criado por um dono e que nao existe no catalogo-mestre do tipo de
// negocio da loja (Fase 8.2). O super admin ve-os agrupados por nome e pode
// acrescenta-los ao catalogo-mestre. Fotografia do produto no momento.
model CatalogSuggestion {
  id            String    @id @default(uuid())
  tenant_id     String
  product_id    String
  business_type String
  product_name  String
  name_key      String
  category      String
  icon          String?
  barcode       String?
  cost_price    Int       @default(0)
  sell_price    Int       @default(0)
  status        String    @default("pending")
  created_at    DateTime  @default(now())
  resolved_at   DateTime?
  resolved_by   String?
  tenant        Tenant    @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, product_id])
  @@index([status, business_type, name_key])
}
