# falhado) que era uma copia integra do .env com a password do Postgres e as
# chaves do Supabase/Twilio em texto claro. Nao estava coberto por nenhum
# padrao acima e estava a um `git add` de ir para o historico.
txt
**/txt
*.env.bak
*.env.backup
*.env.old
*.env.save
*.env.swp

